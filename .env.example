# Copy to .env.local and fill in from the CloudFormation stack's Outputs (see admin/README.md).
# None of these are secrets: the API checks every request's sign-in token and role.
# Leave them empty to run the admin console in demo mode (sample data in the browser only).
VITE_CONSOLE_API_URL=
VITE_AWS_REGION=ap-south-1
VITE_COGNITO_CLIENT_ID=
